# ---------------------------------------------------------------------------
# SnZ Ventures — environment
#
# Copy to .env.local for development, or paste into Vercel → Settings →
# Environment Variables for production. Fill in ONLY what you actually use.
#
# Never commit .env.local. This template is the only env file in git, and it
# must never contain a real value.
#
# Design rule throughout the app: a missing variable degrades the feature
# honestly (503 + a human explanation). It never falls back to a guessable
# default and it never pretends the feature worked.
# ---------------------------------------------------------------------------

# Canonical origin. Drives canonical URLs, OG tags, sitemap, robots and the
# password-reset links sent by email.
NEXT_PUBLIC_SITE_URL=https://www.snzventures.com


# === CLIENT PORTAL — DATABASE (required to enable accounts) ================
# Any PostgreSQL 13+ instance: Neon, Supabase, Vercel Postgres, RDS, Railway.
# No extensions are required — the schema uses core gen_random_uuid() only,
# so it installs on managed roles that cannot CREATE EXTENSION.
#
# Use the POOLED connection string on serverless (Neon "-pooler", Supabase
# port 6543). The client runs with prepare:false so transaction pooling is safe.
#
#   postgres://user:password@host/dbname?sslmode=require
#
# Then, once: npm run db:migrate && npm run db:bootstrap -- --email you@…
DATABASE_URL=


# === CLIENT PORTAL — SESSION SIGNING (required) ============================
# Signs session cookies and password-reset tokens. 32+ characters.
# Without it the portal refuses to authenticate anyone rather than falling
# back to a predictable key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Generate it OUTSIDE the repository and paste it straight into Vercel.
# It must never appear in source, in git, or in a log line.
AUTH_SECRET=


# === DOCUMENT STORAGE ======================================================
# Client documents contain passports, transcripts and financial records.
# They are NEVER written to /public, to git, or to the Vercel filesystem.
# Configure ONE transport. Without one, uploads return 503.

# Option A — S3-compatible, PRIVATE bucket (recommended for production).
# Works with AWS S3, Cloudflare R2, Backblaze B2, Wasabi, MinIO.
# The bucket must block all public access; the app mints short-lived
# (~2 minute) signed GET URLs per authorised download.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Option B — Vercel Blob. Simpler to provision, but note the honest caveat:
# the Blob SDK only issues `access: "public"` objects, so the unguessable
# 20-hex key is the only boundary. Access control still happens server-side
# (the key is never sent to a browser), but prefer S3 for regulated data.
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_BASE_URL=


# === EMAIL DELIVERY ========================================================
# Enquiry forms, email verification and password resets all use this.
# Configure ONE transport. Without one, the enquiry API returns 503 and the
# form shows the direct contact details — it never pretends a message was sent.

# Option A — Resend (https://resend.com)
RESEND_API_KEY=

# Option B — any webhook (Zapier, Make, n8n, a CRM intake, an SMTP relay)
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=

# Sender must be on a domain you control and have verified with the provider.
MAIL_FROM="SnZ Ventures <noreply@snzventures.com>"
# Where enquiries land. Defaults to info@snzventures.com.
MAIL_TO=info@snzventures.com


# === ANALYTICS & TRACKING ==================================================
# ⚠ Implement cookie consent BEFORE setting any of these for EU visitors.
# Nothing loads while these are blank.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GADS_ID=
