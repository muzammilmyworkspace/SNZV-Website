# ---------------------------------------------------------------------------
# SnZ Ventures — environment
# Copy to .env.local and fill in ONLY what you actually use.
# Every value is optional: unset means the corresponding script never loads.
# ---------------------------------------------------------------------------

# Canonical origin. Drives canonical URLs, OG tags, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://www.snzventures.com

# --- Analytics & tracking -------------------------------------------------
# ⚠ Implement cookie consent BEFORE setting any of these for EU visitors.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GADS_ID=

# --- Lead delivery --------------------------------------------------------
# Not yet implemented. See app/api/enquiry/route.ts -> deliver()
# Example for Resend:
# RESEND_API_KEY=
# ENQUIRY_TO_EMAIL=info@snzventures.com
